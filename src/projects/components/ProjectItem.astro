---
import type { Project } from "../constants/projects";
const { project } = Astro.props;
---

<div
    class="group px-4 py-2
            bg-secondary-800 hover:bg-white
            text-cyan-400 hover:text-black
            transition-all duration-300 ease-out
            hover:shadow-[4px_-4px_0_0_theme(colors.tertiary.500)]"
>
    <div class="-skew-x-6 flex justify-between">
        <div class="flex relative isolate">
            <!-- Card -->
            <div
                class="border-2 border-b-4 w-8 h-12 rotate-12
                    border-cyan-400 group-hover:border-white
                    bg-secondary-800 group-hover:bg-black
                    group-hover:text-white
                    flex flex-col items-center absolute
                    -translate-x-4 z-20 overflow-hidden pt-2"
            >
                <p class="uppercase font-bold font-jetbrains -rotate-12">
                    {project.numberCard}
                </p>
                <div
                    class="size-4 bg-cyan-400 group-hover:bg-white translate-y-1.5"
                    style="clip-path: circle(50% at 50% 50%);"
                >
                </div>
            </div>
            <p
                class="capitalize font-jetbrains text-3xl font-bold ms-5 z-0 relative"
            >
                {project.card}
            </p>
        </div>
        <p
            class="font-sora font-bold uppercase relative me-8 translate-y-4 text-sm"
        >
            rank
            <span class="text-4xl absolute -translate-y-3">
                {project.rank}
            </span>
        </p>
    </div>
    <p
        class="capitalize font-jetbrains font-bold text-xl
            bg-cyan-400 group-hover:bg-black
            text-secondary-800 group-hover:text-white
            -skew-x-6 px-12"
    >
        {project.title}
    </p>
</div>
