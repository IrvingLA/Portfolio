---
import Layout from "../shared/components/Layout.astro";
import VideoBg from "../shared/components/VideoBg.astro";

import Experience from "../experience/assets/video/compressed.mp4";
import Mobile from "../experience/assets/video/mobile.mp4";

import ExperienceItem from "../experience/components/ExperienceItem.astro";

import { jobs } from "../experience/constants/jobs";

import "../shared/styles/global.css";
---

<Layout>
    <a
        href="#main"
        data-hover-sound
        class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4
               focus:z-50 focus:bg-black focus:text-primary-400 focus:px-6
               focus:py-2 font-anton uppercase"
    >
        Saltar al contenido
    </a>
    <VideoBg
        src={Experience}
        mobileSrc={Mobile}
        loopStart={0}
        loopEnd={45}
        overlay={true}
        class="object-center"
    />

    <main
        id="main"
        tabindex="-1"
        class="flex items-center justify-center w-full h-full overflow-y-auto"
    >
        <h1 class="sr-only" id="page-heading">Experiencia</h1>
        <section aria-labelledby="page-heading">
            <ol class="space-y-1 py-16">
                {jobs.map((job, i) => <ExperienceItem i={i + 1} job={job} />)}
            </ol>
        </section>
    </main>

    <a
        href="/"
        data-hover-sound
        class="fixed top-4 left-4 z-40 font-anton uppercase text-primary-800
        hover:text-primary-950 transition-colors text-lg"
    >
        Menú
    </a>
</Layout>
