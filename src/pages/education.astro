---
import Layout from "../shared/components/Layout.astro";

import VideoBg from "../shared/components/VideoBg.astro";

import Education from "../education/assets/videos/compressed.mp4";
import Mobile from "../education/assets/videos/mobile.mp4";

import EducationItem from "../education/components/EducationItem.astro";
import EducationDetail from "../education/components/EducationDetail.astro";
import "../shared/styles/global.css";

import { Educations } from "../education/constants/education";
---

<Layout>
    <a
        href="#main"
        data-hover-sound
        class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4
               focus:z-50 focus:bg-black focus:text-primary-400 focus:px-6
               focus:py-2 font-anton uppercase"
    >
        Saltar al contenido
    </a>
    <VideoBg
        src={Education}
        mobileSrc={Mobile}
        loopStart={0}
        loopEnd={19}
        overlay={true}
        class="object-center"
    />

    <main id="main" tabindex="-1" class="flex items-center h-full">
        <h1 class="sr-only" id="page-heading">Educación</h1>
        <section id="education-list" aria-labelledby="page-heading">
            <ul class="space-y-1">
                {Educations.map((item, i) => <EducationItem item={item} id={`edu-${i}`} />)}
            </ul>
        </section>
        <!-- Education section -->
        <div>
            <EducationDetail item={Educations[0]} id="edu-0" />
        </div>
        <!-- Certification section -->
        <div>
            <EducationDetail item={Educations[1]} id="edu-1" />
        </div>
    </main>
    <a
        href="/"
        data-hover-sound
        class="fixed top-4 left-4 z-40 font-anton uppercase text-primary-800
               hover:text-primary-950 transition-colors text-lg"
    >
        Menú
    </a>
    <button
        id="btn-volver"
        data-hover-sound
        class="fixed top-4 right-4 z-40 hidden font-anton uppercase text-primary-800
               hover:text-primary-950 transition-colors text-lg cursor-pointer"
        aria-label="Volver"
    >
        Volver
    </button>
</Layout>

<script>
    (() => {
        const section = document.getElementById("education-list");
        const volver = document.getElementById("btn-volver");
        let openId = null;
        let closing = false;
        let refocusOnClose = false;

        const closeDetail = (detail, id, refocus = true) => {
            closing = true;
            refocusOnClose = refocus;
            detail.classList.remove("p3r-slide-in");
            detail.classList.add("p3r-slide-out");
            detail.addEventListener("animationend", () => {
                detail.classList.add("hidden");
                detail.classList.remove("p3r-slide-out");
                section.classList.remove("hidden");
                volver.classList.add("hidden");
                openId = null;
                closing = false;
                const btn = document.querySelector(`[data-edu-id="${id}"] button`);
                if (btn) btn.setAttribute("aria-expanded", "false");
                if (refocusOnClose && btn) btn.focus();
                new Audio("/sounds/hide-modal.mp3").play().catch(() => {});
            }, { once: true });
        };

        document.addEventListener("click", (e) => {
            const trigger = e.target.closest("[data-edu-id] button");
            if (!trigger) return;
            if (closing) return;

            const id = trigger.closest("[data-edu-id]").dataset.eduId;

            const openDetail = () => {
                const detail = document.querySelector(`[data-edu-detail="${id}"]`);
                if (!detail) return;
                section.classList.add("hidden");
                detail.classList.remove("hidden", "p3r-slide-out");
                void detail.offsetWidth;
                detail.classList.add("p3r-slide-in");
                volver.classList.remove("hidden");
                openId = id;
                trigger.setAttribute("aria-expanded", "true");
                new Audio("/sounds/open-modal.mp3").play().catch(() => {});
                detail.addEventListener("animationend", () => {
                    volver.focus();
                }, { once: true });
            };

            if (openId !== null && openId !== id) {
                const prev = document.querySelector(`[data-edu-detail="${openId}"]`);
                if (prev) {
                    closeDetail(prev, openId, false);
                    prev.addEventListener("animationend", () => {
                        openDetail();
                    }, { once: true });
                    return;
                }
            }

            if (openId === id) return;

            openDetail();
        });

        document.addEventListener("click", (e) => {
            const trigger = e.target.closest("[data-edu-detail]");
            if (!trigger) return;
            if (closing) return;

            if (e.target.closest("[data-weapon-img]")) return;

            const id = trigger.dataset.eduDetail;
            if (!id || openId !== id) return;

            closeDetail(trigger, id);
        });

        document.addEventListener("keydown", (e) => {
            if (e.key !== "Escape") return;
            if (!openId || closing) return;
            const detail = document.querySelector(`[data-edu-detail="${openId}"]`);
            if (!detail) return;
            e.preventDefault();
            closeDetail(detail, openId);
        });

        volver.addEventListener("click", () => {
            if (!openId || closing) return;
            const detail = document.querySelector(`[data-edu-detail="${openId}"]`);
            if (!detail) return;
            closeDetail(detail, openId);
        });
    })();
</script>
