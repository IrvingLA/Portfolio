---
import { Image } from "astro:assets";

import Attack from "../assets/weapons/attack.png";
import Accuracy from "../assets/weapons/accuracy.png";

import EducationDescription from "./EducationDescription.astro";

import type { Education } from "../constants/education";

interface Props {
    item: Education;
    id: string;
}

const { item, id } = Astro.props;
---

<div
    class="w-full md:w-3/4 hidden"
    id={id}
    data-edu-detail={id}
    role="region"
    aria-labelledby={`${id}-heading`}
    tabindex="-1"
>
    <div
        style="clip-path: polygon(0 0, 100% 0%, 98% 100%, 0% 100%);"
        class="mb-8"
    >
        <div class="flex items-center">
            <div
                class="relative inline-flex pointer-events-none bg-black ps-12"
            >
                <Image src={item.avatar} alt={item.alt} class="h-16 w-40" />
                <div
                    class={`absolute inset-0 mix-blend-color ${item.color}`}
                    aria-hidden="true"
                >
                </div>
            </div>
            <div
                class="bg-white font-jetbrains font-bold text-lg -translate-x-28
                        w-56 h-16 flex items-center justify-center"
                style="clip-path: polygon(10% 0, 100% 0, 100% 100%, 25% 100%, 0 40%);"
            >
                <h2 id={`${id}-heading`}>{item.name}</h2>
            </div>
        </div>
        <div
            class="w-full h-10 bg-black ps-12
            grid grid-cols-8 gap-8
            font-jetbrains font-bold text-white
            text-sm sm:text-xl"
            aria-live="polite"
        >
            <div class="flex items-center col-span-5">
                <img
                    src={item.weapons[0].image.src}
                    alt={item.weapons[0].name}
                    class="h-4 w-10"
                    data-current-weapon
                />
                <h3 data-current-name>{item.weapons[0].name}</h3>
            </div>
            <div class="-translate-y-4">
                <Image
                    src={Attack}
                    alt=""
                    aria-hidden="true"
                    class="-translate-x-4 translate-y-1 h-5 w-auto"
                />
                <span data-current-atk>{item.weapons[0].atk}</span>
            </div>
            <div class="-translate-y-4">
                <Image
                    src={Accuracy}
                    alt=""
                    aria-hidden="true"
                    class="-translate-x-5 translate-y-1 h-5 w-auto"
                />
                <span data-current-acc>{item.weapons[0].acc}</span>
            </div>
        </div>
    </div>
    {
        item.weapons.map((weapon) => (
            <button
                type="button"
                data-hover-sound
                class="w-full text-left bg-secondary-900 hover:bg-neutral-50
                focus-visible:bg-neutral-50 focus-visible:text-black
                grid grid-cols-8 gap-8
                ps-12 pe-12 py-1 mb-1
                font-jetbrains font-bold text-white hover:text-black
                text-sm md:text-lg
                border-t-4 border-e-2 border-transparent
                hover:border-tertiary-600 focus-visible:border-tertiary-600 rounded-e-md
                outline-none
                transition-all duration-300 ease-out"
                data-weapon-img={weapon.image.src}
                data-weapon-name={weapon.name}
                data-weapon-atk={weapon.atk}
                data-weapon-acc={weapon.acc}
                data-weapon-effect={weapon.achievement.effect}
                data-weapon-date={weapon.achievement.date}
                data-weapon-description={weapon.achievement.description}
            >
                <span class="flex col-span-5 items-center">
                    <Image
                        src={weapon.image}
                        alt={weapon.name}
                        class="h-4 w-10"
                    />
                    <span>{weapon.name}</span>
                </span>
                <span>{weapon.atk}</span>
                <span>{weapon.acc}</span>
                <span class="bg-black text-white w-16 text-center rounded-2xl flex justify-evenly font-normal text-sm items-center" aria-hidden="true">
                    <span>x</span>
                    <span>1</span>
                </span>
            </button>
        ))
    }
    <EducationDescription
        achievement={item.weapons[0].achievement}
        class="mt-8 ps-12"
    />
</div>
<script>
    document.addEventListener("click", (e) => {
        const row = e.target.closest("[data-weapon-img]");
        if (!row) return;

        const detail = row.closest("[data-edu-detail]");
        if (!detail) return;

        const img = row.dataset.weaponImg;
        const name = row.dataset.weaponName;
        const atk = row.dataset.weaponAtk;
        const acc = row.dataset.weaponAcc;
        const effect = row.dataset.weaponEffect;
        const date = row.dataset.weaponDate;
        const description = row.dataset.weaponDescription;

        const weapon = detail.querySelector("[data-current-weapon]");
        const curName = detail.querySelector("[data-current-name]");
        const curAtk = detail.querySelector("[data-current-atk]");
        const curAcc = detail.querySelector("[data-current-acc]");
        const descEffect = detail.querySelector("[data-achievement-effect]");
        const descDate = detail.querySelector("[data-achievement-date]");
        const descDesc = detail.querySelector("[data-achievement-description]");

        if (weapon) {
            weapon.src = img;
            weapon.alt = name;
        }
        if (curName) curName.textContent = name;
        if (curAtk) curAtk.textContent = atk;
        if (curAcc) curAcc.textContent = acc;
        if (descEffect) descEffect.textContent = effect;
        if (descDate) descDate.textContent = date;
        if (descDesc) descDesc.textContent = description;

        new Audio("/sounds/open-modal.mp3").play().catch(() => {});
    });
</script>
