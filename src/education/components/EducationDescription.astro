---
import type { Achievement } from "../constants/education";

interface Props {
    achievement: Achievement;
    class?: string;
}

const { achievement, class: className } = Astro.props;
---

<div
    class={`bg-secondary-900/90 font-bold font-jetbrains text-primary-600 py-4 ${className}`}
    aria-live="polite"
>
    <div class="flex mb-2">
        <div class="bg-primary-600 px-4 rounded-md me-2">
            <p class="capitalize text-secondary-800 font-sora">effect</p>
        </div>
        <p data-achievement-effect>{achievement.effect}</p>
    </div>
    <div class="flex flex-wrap ps-2">
        <div>
            <p class="capitalize border rounded-2xl px-6 text-sm scale-75">
                info
            </p>
        </div>
        <div>
            <p data-achievement-date>{achievement.date}</p>
            <p data-achievement-description>{achievement.description}</p>
        </div>
    </div>
</div>
