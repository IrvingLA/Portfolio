---
import { Image } from "astro:assets";
import type { Education } from "../constants/education";

interface Props {
    item: Education;
    id: string;
}

const { item, id } = Astro.props;
---

<li class="relative group w-fit" data-hover-sound data-edu-id={id}>
    <div
        class="absolute inset-0 pointer-events-none -translate-y-2 translate-x-2
        bg-tertiary-500 opacity-0 group-hover:opacity-100 transition-opacity duration-400"
        style="clip-path: polygon(0 20%, 100% 0, 98% 100%, 0% 100%);"
        aria-hidden="true"
    >
    </div>
    <button
        type="button"
        aria-expanded="false"
        class="bg-black text-white font-sora w-fit
            flex items-center px-16 space-x-2
            hover:bg-neutral-50 hover:text-black hover:ps-24
            focus-visible:bg-neutral-50 focus-visible:text-black focus-visible:ps-24
            focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-400 focus-visible:ring-offset-2 focus-visible:ring-offset-black
            transition-colors ease-in cursor-pointer relative z-10"
        style="clip-path: polygon(0 0, 100% 0, 98% 100%, 0% 100%);"
    >
        <div class="relative inline-flex pointer-events-none">
            <Image src={item.avatar} alt={item.alt} class="h-12 sm:w-32" />
            <div
                class={`absolute inset-0 mix-blend-color ${item.color}`}
                aria-hidden="true"
            >
            </div>
        </div>
        <span class="capitalize skew-x-2 md:text-xl w-28 pointer-events-none">
            {item.name}
        </span>
    </button>
</li>
