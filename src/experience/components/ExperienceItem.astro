---
import { Job } from "../constants/jobs";
interface Props {
    i: number;
    job: Job;
}

const { i, job } = Astro.props;
---

<li class="bg-white h-28 flex items-center justify-center overflow-hidden">
    <p
        class="font-bold font-sora text-xl -translate-y-10 ps-2 pe-2 text-blue-700"
    >
        {i}
    </p>
    <div class="relative h-full w-[45rem] ms-2 group">
        <!-- Parallelogram -->
        <div
            class="absolute inset-0 z-0 bg-blue-700 -translate-x-20 w-[25rem]"
            style="clip-path: polygon(20% 0%, 100% 0%, 80% 100%, 0% 100%);"
        >
        </div>
        <div
            class="absolute inset-0 z-10 text-white
            flex items-center justify-center space-x-2 group"
        >
            <div>
                <p class="font-bold font-sora text-xl">{job.dateStart}</p>
                <p class="font-bold font-sora text-xl">{job.dateEnd}</p>
            </div>
            <!-- Triangle -->
            <div
                class="size-14 bg-white text-blue-700 font-bold font-sora
                            flex justify-center translate-y-2"
                style="clip-path: polygon(0 0, 100% 0, 50% 70%);"
            >
                <p>{job.day}</p>
            </div>
            <p
                class="font-sora font-bold text-white capitalize w-fit text-center"
            >
                Evening
            </p>
            <!-- Moon -->
            <div
                class="relative size-10 rounded-full overflow-hidden bg-[#161d42]"
            >
                <div class="absolute inset-0 rounded-full bg-black"></div>
                <div
                    class="absolute inset-0 rounded-full -translate-x-[20%]
                     bg-[#f6df1f] [clip-path:circle(90%)]"
                >
                </div>
            </div>
            <div>
                <div class="bg-black text-white text-lg font-bold px-4 w-96">
                    <p>{job.company}</p>
                </div>
                <div class="flex justify-between text-black text-lg">
                    <p class="capitalize font-sora font-bold">
                        {job.position}
                    </p>
                    <p class="uppercase font-sora font-bold text-xl">
                        <span
                            class="pe-2 text-[10px] text-neutral-500 font-jetbrains"
                        >
                            play time
                        </span>
                        <span class="text-neutral-500">0</span>
                        {job.playTime}
                    </p>
                </div>
                <p
                    class="uppercase text-neutral-500 font-bold text-[12px] w-full flex justify-end"
                >
                    normal
                </p>
            </div>
        </div>
    </div>
</li>
