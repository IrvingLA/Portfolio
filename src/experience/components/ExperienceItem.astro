---
import { Job } from "../constants/jobs";
interface Props {
    i: number;
    job: Job;
}

const { i, job } = Astro.props;
---

<li
    data-hover-sound
    class="bg-secondary-900 hover:bg-white h-28
    flex items-center justify-center
    overflow-hidden group hover:scale-110
    transition-all duration-300 ease-out
    hover:shadow-[4px_-4px_0_0_theme(colors.tertiary.500)]"
>
    <div
        class="font-bold font-sora text-xl
       text-secondary-900 bg-secondary-300
        group-hover:text-blue-700 group-hover:bg-white
        -translate-y-8 px-2 pt-1 z-10 size-12
        transition-colors duration-300 ease-out"
        style="clip-path: polygon(0 0, 0% 100%, 100% 0);"
    >
        <p>
            {i}
        </p>
    </div>
    <div class="relative h-full w-[42rem] ms-2 group">
        <!-- Parallelogram -->
        <div
            class="absolute inset-0 z-0 -translate-x-20 w-[23rem]
            bg-secondary-900 group-hover:bg-blue-700
            transition-colors duration-300 ease-out"
            style="clip-path: polygon(0 0%, 100% 0%, 80% 100%, 0% 100%);"
        >
        </div>
        <div
            class="absolute inset-0 z-10
            text-secondary-300 group-hover:text-white
            flex items-center justify-center space-x-2 group
            transition-colors duration-300 ease-out"
        >
            <div>
                <p class="font-bold font-sora text-xl">{job.dateStart}</p>
                <p class="font-bold font-sora text-xl">{job.dateEnd}</p>
            </div>
            <!-- Triangle -->
            <div
                class="size-14 font-bold font-sora
                bg-secondary-300 group-hover:bg-white
                text-secondary-900 group-hover:text-blue-700
                flex justify-center translate-y-2
                transition-colors duration-300 ease-out"
                style="clip-path: polygon(0 0, 100% 0, 50% 70%);"
            >
                <p>{job.day}</p>
            </div>
            <p
                class="font-sora font-bold capitalize w-fit text-center
                text-secondary-300 group-hover:text-white
                transition-colors duration-300 ease-out"
            >
                Evening
            </p>
            <!-- Moon -->
            <div class="relative size-10 rounded-full overflow-hidden group">
                <div
                    class="absolute inset-0 rounded-full
                bg-secondary-300 group-hover:bg-black
                    transition-colors duration-300 ease-out"
                >
                </div>
                <div
                    class="absolute inset-0 rounded-full -translate-x-[20%]
                    bg-black group-hover:bg-yellow-300
                    transition-colors duration-300 ease-out
                     [clip-path:circle(90%)]"
                >
                </div>
            </div>
            <div class="group translate-y-5 group-hover:translate-y-0">
                <div
                    class="group-hover:bg-black text-secondary-300 group-hover:text-white
                    text-lg font-bold px-4 w-96
                    transition-colors duration-300 ease-out"
                >
                    <p>{job.company}</p>
                </div>
                <div
                    class="flex justify-between text-black text-lg
                    opacity-0 translate-y-2
                    group-hover:opacity-100 group-hover:translate-y-0
                    transition-all duration-300 ease-out"
                >
                    <p class="capitalize font-sora font-bold">
                        {job.position}
                    </p>
                    <p class="uppercase font-sora font-bold text-xl">
                        <span
                            class="pe-2 text-[10px] text-neutral-500 font-jetbrains"
                        >
                            play time
                        </span>
                        <span class="text-neutral-500">0</span>
                        {job.playTime}
                    </p>
                </div>
                <p
                    class="flex justify-end uppercase text-neutral-500 font-bold text-[12px] w-full
                    opacity-0 translate-y-2
                    group-hover:opacity-100 group-hover:translate-y-0
                    transition-all duration-300 ease-out"
                >
                    normal
                </p>
            </div>
        </div>
    </div>
</li>
