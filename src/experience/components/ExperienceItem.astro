---
import { Job } from "../constants/jobs";
interface Props {
    i: number;
    job: Job;
}

const { i, job } = Astro.props;
const id = `exp-${i}`;

const toISO = (d: string) => {
    const [month, year] = d.split("/");
    return `20${year}-${month}`;
};
---

<li
    class="bg-secondary-900 hover:bg-white w-full relative
    flex flex-col
    overflow-hidden group hover:scale-[1.03] hover:z-20
    transition-all duration-300 ease-out
    hover:shadow-[4px_-4px_0_0_theme(colors.tertiary.500)]"
>
    <button
        type="button"
        id={`exp-trigger-${i}`}
        data-hover-sound
        data-exp-job
        data-open="false"
        aria-expanded="false"
        aria-controls={`exp-panel-${i}`}
        aria-label={`Ver destacados: ${job.company}, ${job.position}, ${job.dateStart} - ${job.dateEnd}`}
        class="w-full text-left p-0 relative
        flex flex-col items-center justify-center cursor-pointer
        focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-400
        focus-visible:ring-offset-2 focus-visible:ring-offset-black"
    >
        <!-- Parallelogram -->
        <div
            class="absolute inset-0 z-0 -translate-x-5 md:-translate-x-8 w-80 md:w-[23rem]
            bg-secondary-900 group-hover:bg-blue-700 group-focus-visible:bg-blue-700
            transition-colors duration-300 ease-out"
            style="clip-path: polygon(0 0%, 100% 0%, 80% 100%, 0% 100%);"
        >
        </div>
        <div
            class="h-36 md:h-28 flex items-center justify-center -translate-x-8 md:translate-0"
        >
            <div
                class="font-bold font-sora text-lg md:text-xl
               text-secondary-900 bg-secondary-300
                group-hover:text-blue-700 group-hover:bg-white
                -translate-y-14 md:-translate-y-8 -translate-x-4 md:translate-x-0
                px-1 md:px-2 pt-1 z-10 size-10 md:size-12
                transition-colors duration-300 ease-out"
                style="clip-path: polygon(0 0, 0% 100%, 100% 0);"
            >
                <span class="block" aria-hidden="true">
                    {i}
                </span>
            </div>
            <div class="relative h-full w-60 md:w-[42rem] ms-2 group">
                <div
                    class="absolute inset-0 z-10
                    text-secondary-300 group-hover:text-white group-focus-visible:text-white
                    flex items-center justify-center space-x-2 group
                    flex-col md:flex-row space-y-2
                    group transition-colors duration-300 ease-out"
                >
                    <div
                        class="flex items-center justify-center space-x-2 group"
                    >
                        <div>
                            <time
                                class="block font-bold font-sora text-lg md:text-xl"
                                datetime={toISO(job.dateStart)}
                            >
                                {job.dateStart}
                            </time>
                            <time
                                class="block font-bold font-sora text-lg md:text-xl"
                                datetime={toISO(job.dateEnd)}
                            >
                                {job.dateEnd}
                            </time>
                        </div>
                        <!-- Triangle -->
                        <div
                            class="size-14 font-bold font-sora text-sm md:text-base
                        bg-secondary-300 group-hover:bg-white
                        text-secondary-900 group-hover:text-blue-700
                        flex justify-center translate-y-2
                        transition-colors duration-300 ease-out"
                            style="clip-path: polygon(0 0, 100% 0, 50% 70%);"
                        >
                            <span aria-hidden="true">{job.day}</span>
                        </div>
                        <span
                            class="block font-sora font-bold capitalize w-fit text-center text-sm md:text-base
                        text-secondary-300 group-hover:text-white
                        transition-colors duration-300 ease-out"
                            aria-hidden="true"
                        >
                            Evening
                        </span>
                        <!-- Moon -->
                        <div
                            class="relative size-10 rounded-full overflow-hidden group"
                            aria-hidden="true"
                        >
                            <div
                                class="absolute inset-0 rounded-full
                        bg-secondary-300 group-hover:bg-black
                            transition-colors duration-300 ease-out"
                            >
                            </div>
                            <div
                                class="absolute inset-0 rounded-full -translate-x-[20%]
                            bg-black group-hover:bg-yellow-300
                            transition-colors duration-300 ease-out
                             [clip-path:circle(90%)]"
                            >
                            </div>
                        </div>
                    </div>
                    <div
                        class="group translate-y-5 group-hover:translate-y-0 group-focus-visible:translate-y-0"
                    >
                        <div
                            class="group-hover:bg-black group-focus-visible:bg-black text-secondary-300 group-hover:text-white group-focus-visible:text-white
                            text-base md:text-lg font-bold px-4
                            w-80 md:w-96
                            transition-colors duration-300 ease-out"
                        >
                            <span class="block">{job.company}</span>
                        </div>
                        <div
                            class="flex justify-between text-black text-base md:text-lg
                            opacity-0 translate-y-2
                            group-hover:opacity-100 group-hover:translate-y-0 group-focus-visible:opacity-100 group-focus-visible:translate-y-0
                            transition-all duration-300 ease-out"
                        >
                            <span class="block capitalize font-sora font-bold">
                                {job.position}
                            </span>
                            <span
                                class="block uppercase font-sora font-bold text-lg md:text-xl"
                                aria-hidden="true"
                            >
                                <span
                                    class="pe-2 text-[10px] text-black md:text-neutral-500 font-jetbrains"
                                >
                                    play time
                                </span>
                                <span class="text-neutral-500">0</span>
                                {job.playTime}
                            </span>
                        </div>
                        <span
                            class="flex justify-end uppercase text-neutral-500 font-bold text-[12px] w-full
                            opacity-0 translate-y-2
                            group-hover:opacity-100 group-hover:translate-y-0 group-focus-visible:opacity-100 group-focus-visible:translate-y-0
                            transition-all duration-300 ease-out"
                            aria-hidden="true"
                        >
                            normal
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </button>
    <div
        id={`exp-panel-${i}`}
        role="region"
        aria-labelledby={`exp-trigger-${i}`}
        class="acc-panel"
        aria-hidden="true"
    >
        <div>
            <div class="w-96 md:w-[42rem] mx-auto px-2 py-6">
                <ul class="space-y-3">
                    {
                        job.highlights.map((h) => (
                            <li
                                class="flex gap-3
                                font-sora text-xs md:text-sm leading-relaxed
                                text-secondary-300 group-hover:text-black
                                transition-colors duration-300 ease-out"
                            >
                                <span
                                    class="text-tertiary-500 text-xs mt-1.5 shrink-0"
                                    aria-hidden="true"
                                >
                                    ▸
                                </span>
                                <span>{h}</span>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>
    </div>
</li>

<script>
    const play = (src) => new Audio(src).play().catch(() => {});

    const setPanel = (el, open) => {
        el.setAttribute("data-open", String(open));
        el.setAttribute("aria-expanded", String(open));
        const panel = document.getElementById(el.getAttribute("aria-controls"));
        if (panel) {
            panel.setAttribute("aria-hidden", String(!open));
            panel.classList.toggle("acc-open", open);
        }
    };

    const closeAcc = (el, silent = false) => {
        if (el.getAttribute("data-open") !== "true") return;
        setPanel(el, false);
        if (!silent) play("/sounds/hide-modal.mp3");
    };

    const openAcc = (el) => {
        document.querySelectorAll("[data-exp-job]").forEach((other) => {
            if (other !== el) closeAcc(other, true);
        });
        setPanel(el, true);
        play("/sounds/open-modal.mp3");
    };

    const toggleAcc = (el) => {
        if (el.getAttribute("data-open") === "true") closeAcc(el);
        else openAcc(el);
    };

    document.addEventListener("click", (e) => {
        const el = e.target.closest("[data-exp-job]");
        if (!el) return;
        toggleAcc(el);
    });

    document.addEventListener("keydown", (e) => {
        if (e.key !== "Escape") return;
        const open = document.querySelector("[data-exp-job][data-open='true']");
        if (open) closeAcc(open);
    });
</script>
